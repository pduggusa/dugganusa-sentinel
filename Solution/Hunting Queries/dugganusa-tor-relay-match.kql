// DugganUSA Tor Relay Matching — Sentinel Hunting Query
// Identifies connections to/from known Tor relay IPs in your logs.
//
// Data source: DugganUSA Tor Infrastructure Attribution Framework
// API: https://analytics.dugganusa.com/api/v1/tor/relays
//
// Setup: create a Sentinel watchlist named "DugganUSA_TorRelays" (search key: address) from
//   GET https://analytics.dugganusa.com/api/v1/tor/relays?isExit=true&limit=500&format=csv
// sent with your API key in the Authorization header (Bearer). Refresh it on a schedule (Logic App)
// or by hand. KQL externaldata() cannot send that header, so this query reads the watchlist.
// (Until 1.4.0 this query used externaldata() against the anonymous URL; anonymous access was
// disabled, so it silently returned nothing.)
let TorExitRelays = _GetWatchlist('DugganUSA_TorRelays')
    | project address = tostring(column_ifexists('SearchKey', '')), nickname = tostring(column_ifexists('nickname', '')),
              country = tostring(column_ifexists('country', '')), asnOrg = tostring(column_ifexists('asnOrg', ''));

// Match against CommonSecurityLog (firewall/proxy logs)
CommonSecurityLog
| where TimeGenerated > ago(24h)
| where DestinationIP in (TorExitRelays | project address)
    or SourceIP in (TorExitRelays | project address)
| join kind=leftouter (TorExitRelays) on $left.DestinationIP == $right.address
| project TimeGenerated,
    Direction = iff(DestinationIP in (TorExitRelays | project address), "OUTBOUND to Tor", "INBOUND from Tor"),
    LocalIP = iff(DestinationIP in (TorExitRelays | project address), SourceIP, DestinationIP),
    TorRelayIP = iff(DestinationIP in (TorExitRelays | project address), DestinationIP, SourceIP),
    RelayNickname = nickname,
    RelayCountry = country,
    RelayASN = asnOrg,
    DeviceAction,
    Activity,
    DeviceVendor,
    DeviceProduct
| sort by TimeGenerated desc

// OUTBOUND connections to Tor exit nodes may indicate:
// - Data exfiltration via Tor
// - Ransomware victim communicating with payment portal
// - Malware using Tor for C2
// - Legitimate Tor Browser usage (verify with user)
//
// INBOUND connections from Tor exit nodes may indicate:
// - Anonymized scanning/probing
// - Credential stuffing from Tor
// - Legitimate anonymous access
//
// Cross-reference high-bandwidth exit relays (BW > 20000) for exfiltration detection.
// The Quetzalcoatl cluster (50 relays, all exit, 1337 Services GmbH) is worth extra scrutiny.
